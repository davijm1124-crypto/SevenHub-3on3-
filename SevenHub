    def social_media_enum(self, username):
        """Enumera presença em redes sociais"""
        self.status(f"Enumerando usuário: @{username}", "info")
        self.loading_bar("Verificando plataformas...", 3)
        
        platforms = {
            "Twitter/X": f"https://twitter.com/{username}",
            "Instagram": f"https://instagram.com/{username}",
            "TikTok": f"https://tiktok.com/@{username}",
            "YouTube": f"https://youtube.com/@{username}",
            "GitHub": f"https://github.com/{username}",
            "LinkedIn": f"https://linkedin.com/in/{username}",
            "Reddit": f"https://reddit.com/user/{username}",
            "Pinterest": f"https://pinterest.com/{username}",
            "Flickr": f"https://flickr.com/people/{username}",
            "SoundCloud": f"https://soundcloud.com/{username}"
        }
        
        results = {
            "username": username,
            "platforms": {},
            "timestamp": self.get_timestamp()
        }
        
        for platform, url in platforms.items():
            try:
                response = requests.head(url, timeout=10, allow_redirects=True)
                exists = response.status_code not in [404, 403, 401]
                results["platforms"][platform] = {
                    "url": url,
                    "exists": exists,
                    "status_code": response.status_code
                }
                if exists:
                    self.status(f"{platform}: {Colors.OKGREEN}ENCONTRADO{Colors.ENDC}", "success")
                else:
                    self.status(f"{platform}: Não encontrado", "warning")
            except:
                results["platforms"][platform] = {
                    "url": url,
                    "exists": False,
                    "error": "Timeout"
                }
        
        self.save_result("social_media", username, results)
        self.status("Enumeração de redes sociais concluída!", "success")
        return results
    
    # ==================== MÓDULO SUBDOMAIN ENUM ====================
    def subdomain_enum(self, domain):
        """Enumera subdomínios"""
        self.status(f"Enumerando subdomínios: {domain}", "info")
        self.loading_bar("Coletando subdomínios...", 3)
        
        # Usando API gratuita ou método alternativo
        try:
            # Try crt.sh (Certificate Transparency)
            url = f"https://crt.sh/?q=%.{domain}&output=json"
            response = requests.get(url, timeout=30)
            
            if response.status_code == 200:
                certs = response.json()
                subdomains = set()
                for cert in certs:
                    name = cert.get('name_value', '')
                    for entry in name.split('\n'):
                        entry = entry.strip().rstrip('.')
                        if entry and entry != domain and entry.endswith('.' + domain):
                            subdomains.add(entry)
                
                results = {
                    "domain": domain,
                    "subdomains": sorted(list(subdomains)),
                    "total_found": len(subdomains),
                    "timestamp": self.get_timestamp()
                }
                
                self.save_result("domains", f"{domain}_subdomains", results)
                self.status(f"{len(subdomains)} subdomínios encontrados!", "success")
                return results
                
        except Exception as e:
            self.status(f"Erro na enumeração: {str(e)}", "error")
        
        return {"domain": domain, "subdomains": [], "total_found": 0}
    
    # ==================== MÓDULO PORT SCANNER ====================
    def port_scan(self, ip, ports="common"):
        """Scan de portas simplificado"""
        self.status(f"Escaneando portas: {ip}", "info")
        self.loading_bar("Verificando portas abertas...", 3)
        
        if ports == "common":
            target_ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 993, 995, 
                          3306, 3389, 5432, 8080, 8443, 9090]
        elif isinstance(ports, str) and ',' in ports:
            target_ports = [int(p.strip()) for p in ports.split(',')]
        else:
            target_ports = [int(ports)]
        
        open_ports = []
        services = {
            21: "FTP", 22: "SSH", 23: "Telnet", 25: "SMTP",
            53: "DNS", 80: "HTTP", 110: "POP3", 143: "IMAP",
            443: "HTTPS", 993: "IMAPS", 995: "POP3S",
            3306: "MySQL", 3389: "RDP", 5432: "PostgreSQL",
            8080: "HTTP-Proxy", 8443: "HTTPS-Alt", 9090: "WebAdmin"
        }
        
        for port in target_ports:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(2)
                result = sock.connect_ex((ip, port))
                if result == 0:
                    service = services.get(port, f"Port-{port}")
                    open_ports.append({"port": port, "service": service})
                    self.status(f"Porta {port}/{services.get(port, '?')} ABERTA", "success")
                sock.close()
            except:
                pass
        
        results = {
            "ip": ip,
            "open_ports": open_ports,
            "total_open": len(open_ports),
            "timestamp": self.get_timestamp()
        }
        
        self.save_result("ips", f"{ip}_ports", results)
        self.status(f"{len(open_ports)} portas abertas encontradas!", "success")
        return results
    
    # ==================== MÓDULO HASH & CRYPTO ====================
    def hash_generator(self, input_str, algorithm="sha256"):
        """Gera hash de string"""
        algorithms = {
            "md5": hashlib.md5,
            "sha1": hashlib.sha1,
            "sha256": hashlib.sha256,
            "sha512": hashlib.sha512
        }
        
        hasher = algorithms.get(algorithm.lower(), hashlib.sha256)
        return hasher(input_str.encode()).hexdigest()
    
    def base64_encode(self, text):
        return base64.b64encode(text.encode()).decode()
    
    def base64_decode(self, text):
        try:
            return base64.b64decode(text.encode()).decode()
        except:
            return "Decodificação falhou"
    
