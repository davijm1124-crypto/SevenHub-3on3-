def check_dependencies():
    """Verifica dependências necessárias"""
    deps = {
        "requests": "pip install requests",
        "colorama": "pip install colorama"
    }
    
    missing = []
    for dep, install_cmd in deps.items():
        try:
            __import__(dep)
        except ImportError:
            missing.append(install_cmd)
    
    if missing:
        print(f"{Fore.RED}Dependências faltando:{Style.RESET_ALL}")
        for cmd in missing:
            print(f"  {cmd}")
        print("\nInstalando...")
        for cmd in missing:
            subprocess.run(cmd.split(), check=True)
        print(f"{Fore.GREEN}✓ Dependências instaladas!{Style.RESET_ALL}")


def main():
    """Função principal"""
    check_dependencies()
    
    hub = SevenHub()
    hub.banner()
    
    # Verifica argumentos de linha de comando
    parser = argparse.ArgumentParser(description='SevenHub - OSINT Tool')
    parser.add_argument('--batch', help='Arquivo de alvos para modo batch')
    parser.add_argument('--module', help='Módulo para modo batch')
    parser.add_argument('--quick', help='Modo rápido com alvo único')
    parser.add_argument('--report', action='store_true', help='Gera relatório ao sair')
    
    args = parser.parse_args()
    
    if args.batch and args.module:
        hub.batch_mode(args.batch, args.module)
    elif args.quick:
        # Modo rápido para um alvo
        hub.status(f"Modo rápido ativo: {args.quick}", "info")
        # Aqui você pode adicionar lógica específica
    else:
        # Modo interativo
        try:
            hub.interactive_menu()
        except KeyboardInterrupt:
            print(f"\n{Colors.WARNING}Interrompido pelo usuário.{Colors.ENDC}")
        finally:
            if args.report:
                hub.generate_report()
    
    hub.status("SevenHub encerrado.", "info")


if __name__ == "__main__":
    main()
