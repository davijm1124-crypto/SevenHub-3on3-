            if text:
                hashed = self.hash_generator(text, algo_map[choice])
                print(f"\n{Colors.OKGREEN}Hash ({algo_map[choice].upper()}):{Colors.ENDC} {hashed}")
        elif choice == '5':
            text = input(f"{Colors.BOLD}Texto:{Colors.ENDC} ").strip()
            if text:
                encoded = self.base64_encode(text)
                print(f"\n{Colors.OKGREEN}Base64:{Colors.ENDC} {encoded}")
        elif choice == '6':
            text = input(f"{Colors.BOLD}Base64:{Colors.ENDC} ").strip()
            if text:
                decoded = self.base64_decode(text)
                print(f"\n{Colors.OKGREEN}Decodificado:{Colors.ENDC} {decoded}")
    
    # ==================== MODO BATCH ====================
    def batch_mode(self, targets_file, module):
        """Modo batch para processar múltiplos alvos"""
        try:
            with open(targets_file, 'r') as f:
                targets = [line.strip() for line in f if line.strip()]
            
            self.status(f"Processando {len(targets)} alvos via {module}...", "info")
            
            for i, target in enumerate(targets, 1):
                print(f"\n[{i}/{len(targets)}] Processando: {target}")
                if module == "whois":
                    self.whois_lookup(target)
                elif module == "ip_geo":
                    self.ip_geolocation(target)
                elif module == "email":
                    self.email_intelligence(target)
                elif module == "social":
                    self.social_media_enum(target)
                elif module == "subdomain":
                    self.subdomain_enum(target)
                elif module == "scan":
                    self.port_scan(target)
                elif module == "phone":
                    self.phone_intelligence(target)
                elif module == "url":
                    self.url_analysis(target)
            
            self.status("Batch processing concluído!", "success")
            
        except FileNotFoundError:
            self.status(f"Arquivo não encontrado: {targets_file}", "error")
        except Exception as e:
            self.status(f"Erro no batch: {str(e)}", "error")
    
    # ==================== HELPERS GERAIS ====================
    def clear_screen(self):
        Colors.clear()
        self.banner()
    
    def show_results(self, title, data):
        """Exibe resultados formatados"""
        print(f"\n{Colors.HEADER}--- {title} ---{Colors.ENDC}")
        print(json.dumps(data, indent=2, ensure_ascii=False))
        print(f"{Colors.HEADER}{'='*50}{Colors.ENDC}")


