    def detect_country_from_phone(self, phone):
        """Detecta país baseado no prefixo"""
        prefixes = {
            "+1": "EUA/Canadá", "+44": "Reino Unido", "+49": "Alemanha",
            "+33": "França", "+39": "Itália", "+34": "Espanha",
            "+55": "Brasil", "+52": "México", "+54": "Argentina",
            "+81": "Japão", "+86": "China", "+91": "Índia",
            "+7": "Rússia", "+82": "Coreia do Sul", "+886": "Taiwan"
        }
        
        for prefix, country in prefixes.items():
            if phone.startswith(prefix[1:]):
                return country
        return "Desconhecido"
    
    # ==================== MÓDULO URL ANALYSIS ====================
    def url_analysis(self, url):
        """Analisa URL detalhadamente"""
        self.status(f"Analisando URL: {url}", "info")
        
        parsed = urlparse(url)
        
        results = {
            "url": url,
            "scheme": parsed.scheme,
            "domain": parsed.hostname,
            "port": parsed.port or (443 if parsed.scheme == 'https' else 80),
            "path": parsed.path,
            "query": parsed.query,
            "fragment": parsed.fragment,
            "timestamp": self.get_timestamp()
        }
        
        # Resolve IP
        try:
            ip = socket.gethostbyname(parsed.hostname)
            results["resolved_ip"] = ip
            results["ip_info"] = self.ip_geolocation(ip)
        except:
            results["resolved_ip"] = "Falha na resolução"
        
        self.save_result("domains", f"url_{hashlib.md5(url.encode()).hexdigest()[:8]}", results)
        self.status("Análise de URL concluída!", "success")
        return results
    
    # ==================== MÓDULO GERAÇÃO DE RELATÓRIOS ====================
    def generate_report(self, format="json"):
        """Gera relatório final"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        
        if format == "json":
            filename = f"report_{timestamp}.json"
            with open(os.path.join(RESULTS_DIR, filename), 'w', encoding='utf-8') as f:
                json.dump(self.results, f, indent=2, ensure_ascii=False)
        elif format == "txt":
            filename = f"report_{timestamp}.txt"
            with open(os.path.join(RESULTS_DIR, filename), 'w', encoding='utf-8') as f:
                f.write(f"RELATÓRIO SEVEN HUB\n")
                f.write(f"Gerado em: {self.get_timestamp()}\n")
                f.write("="*50 + "\n\n")
                for key, value in self.results.items():
                    f.write(f"{key}:\n{json.dumps(value, indent=2)}\n\n")
        
        self.status(f"Relatório salvo: {filename}", "success")
        return filename
    
    def save_result(self, category, identifier, data):
        """Salva resultado em arquivo JSON"""
        filename = f"{identifier}_{int(time.time())}.json"
        filepath = os.path.join(RESULTS_DIR, category, filename)
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        
        self.results[f"{category}:{identifier}"] = data
    
