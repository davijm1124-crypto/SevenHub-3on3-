    def loading_bar(self, text, duration=2):
        """Barra de carregamento estilosa"""
        for i in range(int(duration * 10)):
            progress = i / (duration * 10)
            bar = '█' * int(progress * 20) + '░' * (20 - int(progress * 20))
            percent = int(progress * 100)
            print(f"\r{Colors.OKGREEN}[{bar}] {percent}%{Colors.ENDC} {text}", end='', flush=True)
            time.sleep(0.1)
        print()
        
